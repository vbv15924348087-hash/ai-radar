DATABASE_PATH=./data/radar.sqlite
# Without a key, ingestion is real; analysis is explicitly labeled development.
AI_PROVIDER=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
GITHUB_TOKEN=
X_BEARER_TOKEN=
SYNC_INTERVAL_MINUTES=60
RADAR_TIMEZONE=Asia/Shanghai
# For systems where a VPN returns synthetic 198.18.x.x DNS addresses:
# RADAR_DNS_RESOLVER=cloudflare
# Optional existing HTTP(S) proxy for source requests, for example http://127.0.0.1:17891:
RADAR_HTTP_PROXY=
# Optional source timeout in milliseconds (1000-120000); defaults to 15000:
# RADAR_HTTP_TIMEOUT_MS=45000

# Vercel / hosted persistent SQLite (Turso). Leave empty for the local workspace.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Cloud requests require a private workspace password of at least 16 characters.
RADAR_ADMIN_PASSWORD=
# private (default), public (any visitor can edit), or readonly (public reads).
RADAR_ACCESS_MODE=private
# Optional custom domain origins, comma separated; Vercel URLs are detected automatically.
RADAR_PUBLIC_ORIGIN=
# To simulate hosted runtime locally for verification: RADAR_DEPLOYMENT=cloud
